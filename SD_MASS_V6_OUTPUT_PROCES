FUNCTION /RB1M/SD_MASS_V6_OUTPUT_PROCES.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_EXIDV) TYPE  EXIDV
*"     REFERENCE(IV_KSCHL) TYPE  NA_KSCHL OPTIONAL
*"     REFERENCE(IV_PRINTERNAME) TYPE  RSPOLNAME OPTIONAL
*"     REFERENCE(IV_PRINTERTYPE) TYPE  /RB1M/SD_PRITNERTYPE OPTIONAL
*"     REFERENCE(IV_PRINTSUBHUS) TYPE  /RB1M/SD_PRINTSUBHUS OPTIONAL
*"     REFERENCE(IV_VERMO) TYPE  NA_VERMO DEFAULT 1
*"  EXPORTING
*"     REFERENCE(EV_MESSAGE) TYPE  /RB1M/SD_OUTPUT_MESSAGE
*"  EXCEPTIONS
*"      NO_OUTPUTS_SELECTED
*"      NO_OUTPUTS_PROCESSED
*"      NO_PRINTER_FOUND
*"      NO_HU_FOUND
*"      NOT_ALL_OUTPUTS_PROCESSED
*"----------------------------------------------------------------------

**LOCAL DATA DECLARATION **************************************
  CONSTANTS: gc_appl_hu     TYPE kappl      VALUE 'V6',
             gc_true        TYPE xfeld      VALUE 'X',
             gc_nacha_print TYPE na_nacha   VALUE '1'.

  DATA   : lra_objky      TYPE RANGE OF  nast-objky,
           ls_objky       LIKE LINE OF lra_objky,
           lra_nacha      TYPE RANGE OF  nast-nacha,
           ls_nacha       LIKE LINE OF lra_nacha,
           lra_type       TYPE RANGE OF  nast-kschl,
           ls_type        LIKE LINE OF lra_type,
           lv_vermo       TYPE nase-vermo,
           lt_disp        TYPE TABLE OF naliv6,
           ls_disp        TYPE naliv6,

           lv_totcount(3) TYPE n,
           lv_errcount(3) TYPE n,

           lt_msgs        TYPE TABLE OF msg0,
           lt_msgs_add    TYPE TABLE OF msg0,
           lv_padest      TYPE tsp03l-padest,

           lt_return      TYPE bapiret2_t,
           lt_hunumber    TYPE STANDARD TABLE OF bapihunumber WITH DEFAULT KEY,
           ls_hunumber    LIKE LINE OF lt_hunumber,
           lt_huitem      TYPE STANDARD TABLE OF bapihuitem,
           lt_huheader    TYPE STANDARD TABLE OF bapihuheader,
           ls_huheader    LIKE LINE OF lt_huheader.

  FIELD-SYMBOLS <fs_msg> TYPE msg0.


**PROGRAM LOGIC************************************************

* Special logic is needed when we process the outputs strating from SE37.
* The standard program behind SE37 is triggering special logic in FMs
* generated by SAP for the forms (additional try to open job). To avoid that
* we adjust the program name stored in SY-CPROG.
  IF sy-cprog EQ 'RS_TESTFRAME_CALL'.
    sy-cprog = 'RS_TESTFRAME_CALL2'.
  ENDIF.

*  Convert input data
  ls_hunumber-hu_exid =  iv_exidv.
  APPEND ls_hunumber TO lt_hunumber.

*  Get Hus for which we will process the messages
  CALL FUNCTION 'BAPI_HU_GETLIST' "#EC CI_USAGE_OK[2438131]
    EXPORTING
      onlykeys  = ' '
    TABLES
      hunumbers = lt_hunumber
      huheader  = lt_huheader
      huitem    = lt_huitem
      return    = lt_return.

  IF lt_huheader[] IS NOT INITIAL.
    CLEAR: lt_return[], lt_hunumber[].

    SORT lt_huheader BY hu_exid ASCENDING.

    READ TABLE lt_huheader INTO ls_huheader WITH KEY hu_exid = iv_exidv BINARY SEARCH TRANSPORTING hu_id higher_level_hu.
    IF sy-subrc EQ 0.

      ls_objky-sign   = 'I'.
      ls_objky-option = 'EQ'.

      IF ls_huheader-higher_level_hu IS INITIAL AND iv_printsubhus IS NOT INITIAL. "Only for main hus we consider sub-Hus
        LOOP AT lt_huheader INTO ls_huheader.                                      "In lt_huheader we have whole hu-hierarchy
          ls_objky-low = ls_huheader-hu_id.
          APPEND ls_objky TO lra_objky.
        ENDLOOP.
      ELSE.
        ls_objky-low = ls_huheader-hu_id.
        APPEND ls_objky TO lra_objky.
      ENDIF.

    ENDIF.
  ELSE.
    ev_message = TEXT-001.
    RAISE no_hu_found.
  ENDIF.


* ... Check printer
  IF iv_printername IS NOT INITIAL.

    SELECT SINGLE padest FROM /rb4c/bc_i_ddl_tsp03l INTO @lv_padest WHERE lname = @iv_printername.
    "SELECT SINGLE * FROM tsp03l INTO ls_printer WHERE lname  = ls_input-printername. "OR padest = lf_printer4.
    IF sy-subrc NE 0.
      ev_message = TEXT-002.
      RAISE no_printer_found.
    ENDIF.

  ENDIF.


* ... Range-Tab: medium
  ls_nacha-sign = 'I'.
  ls_nacha-option = 'EQ'.
  ls_nacha-low = gc_nacha_print." = 1
  APPEND ls_nacha TO lra_nacha.

*... Range-Tab: Output type
  IF iv_kschl IS NOT INITIAL.
    ls_type-sign = 'I'.
    ls_type-option = 'EQ'.
    ls_type-low = iv_kschl.
    APPEND ls_type TO  lra_type.
  ENDIF.

*... Processing mode
  IF iv_vermo IS INITIAL. "Special mode -> 1+2
    lv_vermo = '1'. "= first processing

    CALL FUNCTION 'WFMC_MESSAGES_SELECT'
      EXPORTING
        pi_application = gc_appl_hu
        pi_processing  = lv_vermo
      TABLES
        ri_medium      = lra_nacha[]
        ri_type        = lra_type[]
        ri_object      = lra_objky[]
        tx_messages    = lt_msgs[].

    lt_msgs_add = lt_msgs.  "Copy messages that were found
    CLEAR: lt_msgs[].

    lv_vermo = '2'. "= repeat processing
  ELSE.
    lv_vermo = iv_vermo.
  ENDIF.


*Select messages to be processed
  CALL FUNCTION 'WFMC_MESSAGES_SELECT'
    EXPORTING
      pi_application = gc_appl_hu
      pi_processing  = lv_vermo
    TABLES
      ri_medium      = lra_nacha[]
      ri_type        = lra_type[]
      ri_object      = lra_objky[]
      tx_messages    = lt_msgs[].


*Combine messages (only when required)
  IF lt_msgs_add IS NOT INITIAL.

    APPEND LINES OF lt_msgs_add TO lt_msgs.
    SORT lt_msgs BY objky kschl spras vstat ASCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_msgs COMPARING objky kschl spras. "First processing is prefere
  ENDIF.


*Adjust the printer
  CALL FUNCTION 'WFMC_MESSAGES_EXTEND'
    TABLES
      tx_messages = lt_msgs[].

  IF iv_printername IS NOT INITIAL.
    LOOP AT lt_msgs[] ASSIGNING <fs_msg>.

      MOVE-CORRESPONDING <fs_msg> TO ls_disp.
      APPEND ls_disp TO lt_disp[].

      <fs_msg>-ldest = lv_padest.
    ENDLOOP.
  ENDIF.

*Print messages
  CALL FUNCTION 'WFMC_MESSAGES_PROCESS'
    EXPORTING
      pi_display_id = 'NALIV6'
      pi_no_dialog  = gc_true
    TABLES
      tx_messages   = lt_msgs[]
      tx_display    = lt_disp[].

  IF lt_msgs[] IS INITIAL. "No messages selected would be signalized with error message

    ev_message = TEXT-003.
    RAISE no_outputs_selected.
  ELSE.
    lv_errcount = 0.

    lv_totcount = lines( lt_msgs ) .                "Total number of outputs to be processed

    LOOP AT lt_msgs ASSIGNING <fs_msg> WHERE pcode NE 'S'. "Number of outputs, which couldn't be processed successfully
      lv_errcount = lv_errcount + 1.
    ENDLOOP.

    IF lv_errcount IS NOT INITIAL.                  "There were some messages, which couldn't be sucessfully processed
      ev_message = TEXT-004.
      REPLACE '&1' IN ev_message WITH lv_errcount.
      REPLACE '&2' IN ev_message WITH lv_totcount.

      IF lv_errcount EQ lv_totcount.                "When no outputs were processed sucessfully we should return error
        RAISE no_outputs_processed.
      ELSE.
        RAISE not_all_outputs_processed.
      ENDIF.
    ELSE.
      ev_message = TEXT-005.                        "All outputs were processed successfully
    ENDIF.
  ENDIF.

  CLEAR sy-subrc.

ENDFUNCTION.
