* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD /rb1m/if_sd_rfid_data~call_rest_api_response.
    IF iv_vstel IS INITIAL." call internal API
      CALL METHOD me->/rb1m/if_sd_rfid_data~call_api_internal_response
        EXPORTING
          is_data     = is_internal_req_data
          iv_plant    = iv_plant
        IMPORTING
          es_response = DATA(lv_response)
          es_msg      = DATA(lv_msg)
          ev_spool    = DATA(lv_spool).
    ELSE." call External API
      CALL METHOD me->/rb1m/if_sd_rfid_data~call_api_external_response
        EXPORTING
          is_data     = is_external_req_data
          iv_plant    = iv_plant
        IMPORTING
          es_response = lv_response
