* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method /RB1M/CL_SD_RFID_DATA->GET_RFC_DEST
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_SRVTYP                      TYPE        /RB1M/SD_USE_CASE (default ='INTERNAL')
* | [--->] IV_PLANT                       TYPE        WERKS_D
* | [<---] ES_RFC_DEST                    TYPE        RFCDEST
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD GET_RFC_DEST.
    "getting service endpoint from the custom table
    SELECT SINGLE RFCDEST
      INTO es_rfc_dest
       FROM /rb1m/sd_service
       WHERE werks = iv_plant
       AND srvtype = iv_srvtyp.

    IF sy-subrc NE 0.
      CLEAR es_rfc_dest.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method /RB1M/CL_SD_RFID_DATA->/RB1M/IF_SD_RFID_DATA~CALL_API_EXTERNAL_RESPONSE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_DATA                        TYPE        /RB1M/SD_EXT_REQ
* | [--->] IV_PLANT                       TYPE        HUM_WERKS
* | [<---] ES_RESPONSE                    TYPE        STRING
* | [<---] ES_MSG                         TYPE        STRING
* | [<---] EV_SPOOL                       TYPE        RSPOTITLE
* +--------------------------------------------------------------------------------------</SIGNATURE>
  method /RB1M/IF_SD_RFID_DATA~CALL_API_EXTERNAL_RESPONSE.

   DATA :lv_printername TYPE rspolname.

    CHECK is_data IS NOT INITIAL.

    CALL FUNCTION 'CONVERSION_EXIT_SPDEV_OUTPUT'
      EXPORTING
        input  = is_data-deviceid
      IMPORTING
        output = lv_printername.

    IF lv_printername CS '_RFID'.
      TRY.
          DATA(lr_framework) = NEW /rb4r/lo_cl_api_framework( iv_plant = iv_plant
                                                              iv_service = mv_servicetype_external ).
          lr_framework->get_data_to_fill( IMPORTING et_body = DATA(lt_body) et_params = DATA(lt_params) ).
          DATA(lv_sid) = sy-sysid && sy-mandt.
          CONDENSE lv_sid.
          LOOP AT lt_params ASSIGNING FIELD-SYMBOL(<fs_param>) WHERE param_value CP '$*$'.
            CASE <fs_param>-param_name.
              WHEN 'customer'.
                <fs_param>-param_value = is_data-customer.
              WHEN 'material'.
                <fs_param>-param_value  = is_data-material.
              WHEN 'hu_no'.
                <fs_param>-param_value = is_data-hu_no.
              WHEN 'deviceID'.
                 <fs_param>-param_value = lv_printername.
              WHEN 'SID'.
                <fs_param>-param_value = lv_sid.
              WHEN 'exidv2'.
                <fs_param>-param_value = is_data-exidv2.
              WHEN 'output_type'.
                <fs_param>-param_value = is_data-output_type.
              WHEN 'shipping_point'.
                <fs_param>-param_value = is_data-shipping_point.
              WHEN 'plant'.
                <fs_param>-param_value = iv_plant.
              WHEN OTHERS.
            ENDCASE.
          ENDLOOP.
          TRY.
              lr_framework->update_api_data_for_call( it_body = lt_body it_params = lt_params ).
              lr_framework->call_api(
                IMPORTING
                  ev_reason           = DATA(lv_reason)
                  ev_code             = DATA(lv_code)
                  et_response_headers = DATA(lt_header)
                  ev_response_body    = DATA(lv_response_body)
                  ev_spool  = DATA(lv_spool)
              ).
            CATCH /rb4r/lo_cx_rest_frmwrk INTO DATA(lr_exception).
              DATA(lv_exception) = lr_exception->get_longtext( ).
          ENDTRY.

        CATCH   /rb4r/lo_cx_rest_frmwrk INTO lr_exception.
          lv_exception = lr_exception->get_longtext( ).
      ENDTRY.

      IF sy-subrc NE 0.
        RETURN.
      ELSE.
        IF lv_code = '200'. "ok
          ev_spool = COND #( WHEN lv_spool IS NOT INITIAL THEN lv_spool ELSE '').
          es_msg = COND #( WHEN lv_code IS NOT INITIAL THEN lv_code ELSE '').
          es_response =  COND #(  WHEN lv_response_body IS NOT INITIAL THEN lv_response_body ELSE '' ).
        ELSE.
          es_response =  |;HU_NU={ is_data-hu_no ALPHA = OUT } |.
          ev_spool =   |;HU_NU={ is_data-hu_no ALPHA = OUT } |.
        ENDIF.
      ENDIF.
    ENDIF.
  endmethod.


