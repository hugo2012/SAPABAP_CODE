CLASS /RB1M/CL_SD_RFID_DATA IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method /RB1M/CL_SD_RFID_DATA->GET_DEVICE_NAME
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DEVICEID                    TYPE        RSPOPSHORT
* | [<---] ES_DEVICENAME                  TYPE        RSPOLNAME
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_device_name.
    "Get device name on basis of device id
    SELECT SINGLE name
      INTO es_devicename
      FROM tsp03d
      WHERE padest = iv_deviceid.

    IF sy-subrc NE 0.
      CLEAR es_devicename.
    ENDIF.

  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method /RB1M/CL_SD_RFID_DATA->GET_EXTERNAL_RESPONSE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_PLANT                       TYPE        HUM_WERKS
* | [--->] IS_DATA                        TYPE        /RB1M/SD_EXT_REQ
* | [--->] IV_NAMESPACE                   TYPE        /AIF/NS (default ='APIOUT')
* | [--->] IV_IFNAME                      TYPE        /AIF/IFNAME (default ='ZRFID_OUT')
* | [--->] IV_IFVER                       TYPE        /AIF/IFVERSION (default ='1')
* | [<---] ES_RESPONSE                    TYPE        STRING
* | [<---] ES_MSG                         TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD get_external_response.

    DATA: lv_url TYPE string.
    DATA: lo_http_client TYPE REF TO if_http_client.
    DATA: lo_rest_client TYPE REF TO cl_rest_http_client.
    DATA: r_json TYPE string.
    DATA: lt_fields TYPE tihttpnvp.
    DATA: lv_param TYPE string.
    DATA : lv_regex TYPE string VALUE '["Spool":"{}]'.

    CHECK is_data-deviceid IS NOT INITIAL AND is_data-deviceid CS '_RFID'.

    "Get the RFC Destination
    me->get_rfc_dest(
      EXPORTING
        iv_srvtyp   = 'EXTERNAL'       " Service type
        iv_plant    =  iv_plant                 " Plant
      IMPORTING
        es_rfc_dest = DATA(lv_rfc_dest)                 " RFC Destination
    ).

    "Fetching resposnse and Filling the AIF structures
    IF sy-subrc EQ 0 AND lv_rfc_dest IS NOT INITIAL.
      DATA(lv_sid) = sy-sysid && sy-mandt.
      CONDENSE lv_sid.
      lv_param = |?shipping_point={ is_data-shipping_point }&material={ is_data-material }&customer={ is_data-customer }&hu_no={ is_data-hu_no }&exidv2={ is_data-exidv2 }&deviceID={ is_data-deviceid }&output_type={ is_data-output_type }&SID={ lv_sid } |.
      lv_url = lv_param.

      " Create http client using destination
      CALL METHOD cl_http_client=>create_by_destination
        EXPORTING
          destination                = lv_rfc_dest                " Logical destination (specified in function call)
        IMPORTING
          client                     = lo_http_client                 " HTTP Client Abstraction
        EXCEPTIONS
          argument_not_found         = 1                " Connection parameter (destination) not available
          destination_not_found      = 2                " Destination was not found
          destination_no_authority   = 3                " No Authorization to Use HTTP Destination
          plugin_not_active          = 4                " HTTP/HTTPS communication not available
          internal_error             = 5                " Internal error (e.g. name too long)
          oa2c_set_token_error       = 6                " General error when setting the OAuth token
          oa2c_missing_authorization = 7
          oa2c_invalid_config        = 8
          oa2c_invalid_parameters    = 9
          oa2c_invalid_scope         = 10
          oa2c_invalid_grant         = 11
          OTHERS                     = 12.
      IF sy-subrc <> 0.

      ENDIF.

      "Setting the request URI
      CALL METHOD cl_http_utility=>set_request_uri
        EXPORTING
          request = lo_http_client->request                 " HTTP Framework (iHTTP) HTTP Request
          uri     = lv_url.                 " URI String (in the Form of /path?query-string)

      "Disable logon pop-up
      lo_http_client->propertytype_logon_popup = lo_http_client->co_disabled.
      lo_http_client->request->set_method( 'GET' ).

      "Header Body
      lo_http_client->request->set_header_fields( VALUE #(

    ( name  = 'Content-Type'    value = 'application/json')
    ( name = 'Accept'           value = 'application/json' )
*    ( name  = 'Authorization'          value = 'Basic Q1RfMzAwMDpTT05OVEFHMQ==')
    ) ).

      "Request Body
      lt_fields = VALUE #( ( name  = 'shipping_point'  value = is_data-shipping_point )
                           ( name  = 'material'        value = is_data-material )
                           ( name  = 'customer'        value = is_data-customer )
                           ( name  = 'hu_no'           value = is_data-hu_no )
                           ( name  = 'deviceID'        value = is_data-deviceid )
                           ( name  = 'exidv2'          value = is_data-exidv2 )
                           ( name  = 'output_type'     value = is_data-output_type )
                           ( name  = 'SID'             value = lv_sid ) ).

      lo_http_client->request->set_form_fields( lt_fields ).

      TRY.
          lo_http_client->send(
            EXPORTING
              timeout = 30
            EXCEPTIONS
              http_communication_failure = 1
              OTHERS                     = 2
          ).
          IF sy-subrc <> 0.
            lo_http_client->get_last_error(
              IMPORTING message = DATA(lv_snd_msg) ).
            es_msg = lv_snd_msg.
          ENDIF.
          lo_http_client->receive(
            EXCEPTIONS
              http_communication_failure = 1
              OTHERS                     = 2
          ).
          IF sy-subrc <> 0.
            lo_http_client->get_last_error(
              IMPORTING message = DATA(lv_rcv_msg) ).
            es_msg = lv_rcv_msg.
          ENDIF.

          r_json = lo_http_client->response->get_cdata( ).

        CATCH cx_root INTO DATA(lo_exception).
          DATA(lv_msg) = lo_exception->get_text(  ).
          es_msg = lv_msg.
      ENDTRY.
      " Get Status
      lo_http_client->response->get_status(
        IMPORTING
          code   =  DATA(lv_scode)                " HTTP Status Code
          reason =  DATA(lv_reson)                " HTTP status description
      ).
      IF lv_snd_msg IS INITIAL AND lv_rcv_msg IS INITIAL AND lv_msg IS INITIAL AND lv_scode = '200'.
        REPLACE ALL OCCURRENCES OF REGEX lv_regex IN r_json WITH ''.
        es_response = r_json.
      ELSE.
        "Response if some error occurs while calling the service
        es_response =   |;HU_NU={ is_data-hu_no ALPHA = OUT } |.
      ENDIF.

      DATA(ls_return) = /rb4c/cl_ca_aom_enabler=>log(
                          iv_ns             =  iv_namespace
                          iv_ifname         = iv_ifname
                          iv_ifver          = iv_ifver
                          iv_commit         = sy-batch
                          io_http_client    = lo_http_client
                        ).
      IF ls_return IS NOT INITIAL.
        MESSAGE ID      ls_return-id
                TYPE    'S'
                NUMBER  ls_return-number
                WITH    ls_return-message_v1
                        ls_return-message_v2
                        ls_return-message_v3
                        ls_return-message_v4.
      ENDIF.

    ELSE.

      "Response if RFC destination is not maintained in custom table
      es_response =   |;HU_NU={ is_data-hu_no ALPHA = OUT } |.

    ENDIF.


  ENDMETHOD.


