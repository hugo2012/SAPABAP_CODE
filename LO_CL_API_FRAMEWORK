*                                                      iv_uri          = conv #( <fs_uri>-alt_uri )
*                                                      it_headers      = lt_headers_alt ).
*    endif.
  endmethod.


  method GET_DATA_TO_FILL.
        loop at mt_api_parameters assigning field-symbol(<fs_parameter>) where param_value cp '$*$'.
      insert <fs_parameter> into table et_params.
    endloop.

    loop at mt_api_body assigning field-symbol(<fs_body>) where body_value cp '$*$'.
      insert <fs_body> into table et_body.
    endloop.
  endmethod.


  METHOD update_api_data_for_call.
    DATA ls_textid TYPE scx_t100key.

    IF lines( it_params ) IS NOT INITIAL.
      DATA(lt_params_tmp) = it_params.
      SORT lt_params_tmp BY param_name.
      LOOP AT mt_api_parameters ASSIGNING FIELD-SYMBOL(<fs_parmameter>) WHERE param_value CP '$*$'.
        READ TABLE lt_params_tmp ASSIGNING FIELD-SYMBOL(<fs_params_new>) WITH KEY param_name = <fs_parmameter>-param_name BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          ls_textid = VALUE #( msgid = mc_messageclass
                               msgno = '024'
                               attr1 = <fs_parmameter>-param_name ). " invalid call: parameter &1 was not supplied
          DATA(lr_exception) = NEW /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
          RAISE EXCEPTION lr_exception.
        ENDIF.
        " update the parameter with the new value :)
        <fs_parmameter>-param_value = <fs_params_new>-param_value.
      ENDLOOP.
    ENDIF.

    IF lines( it_body ) IS NOT INITIAL.
      DATA(lt_body_tmp)  = it_body.
      SORT lt_body_tmp BY body_name.

      LOOP AT mt_api_body ASSIGNING FIELD-SYMBOL(<fs_body>) WHERE body_value CP '$*$'.
        READ TABLE lt_body_tmp ASSIGNING FIELD-SYMBOL(<fs_body_new>) WITH KEY body_name = <fs_body>-body_name BINARY SEARCH.
        IF sy-subrc IS NOT INITIAL.
          ls_textid = VALUE #( msgid = mc_messageclass
                               msgno = '025'
                               attr1 = <fs_body>-body_name ). " invalid call: body value &1 was not supplied
          lr_exception = NEW /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
          RAISE EXCEPTION lr_exception.
        ENDIF.
        " update the parameter with the new value :)
        <fs_body>-body_value = <fs_body_new>-body_value.
      ENDLOOP.
    ENDIF.
  ENDMETHOD.
ENDCLASS.
