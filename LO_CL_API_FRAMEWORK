  method GENERATE_AUTH_HEADERS.
     data ls_textid    type scx_t100key.
    data ls_header    type ihttpnvp.
    data lr_exception type ref to /rb4r/lo_cx_rest_frmwrk.

    case iv_auth.
      when mc_auth_none.

      when mc_auth_basic.
        if iv_username is initial or iv_password is initial and is_api-rfcdest is initial. "in case of RFC destination we have the Basic Auth included
          ls_textid = value #( msgid = mc_messageclass
                               msgno = '005' ). " for basic auth user and password have to be provided
          lr_exception = new /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
          raise exception lr_exception.
        else.
          generate_basic_auth_headers( exporting iv_password = iv_password
                                                 iv_username = iv_username
                                       importing et_headers  = rt_headers ).
        endif.

      when mc_auth_api_key.
        if iv_api_key_param is initial or iv_api_key_value is initial.
          ls_textid = value #( msgid = mc_messageclass
                               msgno = '009' ). " for API Key Method Key and value have to be provided
          lr_exception = new /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
          raise exception lr_exception.
        else.
          ls_header-name  = iv_api_key_param.
          ls_header-value = iv_api_key_value.
          insert ls_header into table rt_headers.
        endif.

      when mc_auth_oauth.
        if iv_oauth_key is initial or iv_oauth_key_value is initial or iv_token_name is initial."or iv_token_value is initial.
          ls_textid = value #( msgid = mc_messageclass
                               msgno = '010' ). " for oAuth Method minimum Key and value + token name and value have to be provided
          lr_exception = new /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
          raise exception lr_exception.
        else.
          ls_header-name  = iv_oauth_key.
          ls_header-value = iv_oauth_key_value.
          insert ls_header into table rt_headers.
          ls_header-name  = iv_token_name.
          ls_header-value = iv_token_value.
          insert ls_header into table rt_headers.
        endif.

        if iv_username is not initial and iv_password is not initial."in some cases we also need username/password for the oAuth call...
          generate_basic_auth_headers( exporting iv_password = iv_password
                                                 iv_username = iv_username
                                       importing et_headers  = rt_headers ).
        endif.
    endcase.
  endmethod.


  method GENERATE_BASIC_AUTH_HEADERS.
    data lr_base64encoder type ref to cl_http_utility.
    data ls_header        type ihttpnvp.

    lr_base64encoder = new cl_http_utility( ).
    data(lv_tpcredentials) = lr_base64encoder->if_http_utility~encode_base64( |{ iv_username }:{ iv_password }| ).
    ls_header-name  = 'Authorization'.
    ls_header-value = |Basic { lv_tpcredentials }|.
    insert ls_header into table et_headers.
  endmethod.


