CLASS /rb4r/lo_cl_api_framework DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    TYPES:
      BEGIN OF ty_parameter,
        header_name  TYPE string,
        header_value TYPE string,
      END OF ty_parameter .
    TYPES:
      tty_paramters TYPE STANDARD TABLE OF ty_parameter .
    TYPES:
      BEGIN OF ty_api,
        main_api  TYPE REF TO /rb4r/lo_cl_rest_api_request,
        alt_api   TYPE REF TO /rb4r/lo_cl_rest_api_request,
        loc_id    TYPE werks_d,
        process   TYPE /rb4r/lo_use_case,
        method    TYPE /rb4r/lo_method,
        auth_mode TYPE /rb4r/lo_auth_mode,
        namespace TYPE 	/aif/ns,
        ifname    TYPE /aif/ifname,
        ifver     TYPE  /aif/ifversion,
      END OF ty_api .

    DATA ms_api TYPE ty_api READ-ONLY .
    CONSTANTS mc_auth_none TYPE /rb4r/lo_auth_mode VALUE space ##NO_TEXT.
    CONSTANTS mc_auth_basic TYPE /rb4r/lo_auth_mode VALUE 'B' ##NO_TEXT.
    CONSTANTS mc_auth_api_key TYPE /rb4r/lo_auth_mode VALUE 'K' ##NO_TEXT.
    CONSTANTS mc_auth_oauth TYPE /rb4r/lo_auth_mode VALUE 'O' ##NO_TEXT.
    CONSTANTS mc_messageclass TYPE msgid VALUE '/RB4R/LO_REST_FW' ##NO_TEXT.
    CONSTANTS mc_param_path TYPE string VALUE '1' ##NO_TEXT.
    CONSTANTS mc_param_query TYPE string VALUE '2' ##NO_TEXT.


    METHODS constructor
      IMPORTING
        !iv_plant   TYPE werks_d
        !iv_service TYPE /rb4r/lo_use_case
      RAISING
        /rb4r/lo_cx_rest_frmwrk .
    "! reads the data fields (from buffered customizing) which have to be replaced with the real data
    "! in order to send the correct request
    "!
    "! @parameter et_body   | table of body content fields
    "! @parameter et_params | table of parameter content fields
    METHODS get_data_to_fill
      EXPORTING
        !et_body   TYPE /rb4r/lo_api_body_tt
        !et_params TYPE /rb4r/lo_api_pa_tt .
    "! updates the data fields which with the corrected values for the actual call
    "!
    "! @parameter it_body                  | table of body content fields
    "! @parameter it_params                | table of parameter content fields
    "! @raising   /RB4R/LO_CX_REST_FRMWRK | generic exception for REST framework
    METHODS update_api_data_for_call
      IMPORTING
        !it_body   TYPE /rb4r/lo_api_body_tt
        !it_params TYPE /rb4r/lo_api_pa_tt
      RAISING
        /rb4r/lo_cx_rest_frmwrk .
    "! actually calling the API and exporting the response for handling it within the program flow
    "!
    "! @parameter ev_reason                | http status reason
    "! @parameter ev_code                  | http status code
    "! @parameter et_response_headers      | http response headers
    "! @parameter ev_response_body         | http response body
    "! @raising   /RB4R/LO_CX_REST_FRMWRK | generic exception for REST framework
    METHODS call_api
      EXPORTING
        !ev_reason           TYPE string
        !ev_code             TYPE numc3
        !et_response_headers TYPE tihttpnvp
        !ev_response_body    TYPE string
        !ev_spool            TYPE rspotitle
      RAISING
        /rb4r/lo_cx_rest_frmwrk .
protected section.
PRIVATE SECTION.
  DATA mt_relevant_apis  TYPE STANDARD TABLE OF /rb4r/lo_apis.
  DATA mt_api_headers    TYPE STANDARD TABLE OF /rb4r/lo_api_hf.
  DATA mt_api_parameters TYPE STANDARD TABLE OF /rb4r/lo_api_pa.
  DATA mt_api_body       TYPE STANDARD TABLE OF /rb4r/lo_api_bo.
*    data mt_api_uri        type standard table of /rb4r/lo_api_uri.
*    data mt_api_auth       type standard table of /rb4r/lo_api_aut.


