CLASS /RB4R/LO_CL_API_FRAMEWORK IMPLEMENTATION.


  METHOD call_api.
    DATA lv_initial_loop     TYPE abap_bool VALUE abap_true.
    DATA lv_code             TYPE numc3.
    DATA lv_reason           TYPE string.
    DATA lt_response_headers TYPE tihttpnvp.
    DATA lv_response_body    TYPE string.
    DATA ls_textid           TYPE scx_t100key.
    DATA lt_cookies          TYPE tihttpcki.
    DATA lv_body             TYPE string.

    " first check if the API is Oauth and fetch the token for the main call
    IF ms_api-alt_api IS BOUND.
      DATA(lv_complete_uri) = ms_api-alt_api->mv_uri.

      LOOP AT mt_api_parameters ASSIGNING FIELD-SYMBOL(<fs_param>) WHERE param_mode = mc_param_path." AND odata_get_flag = abap_true.
        lv_complete_uri = |{ lv_complete_uri }('{ <fs_param>-param_name }={ <fs_param>-param_value }')|.
      ENDLOOP.

      LOOP AT mt_api_parameters ASSIGNING <fs_param> WHERE param_mode = mc_param_query." AND odata_get_flag = abap_true.
        IF lv_initial_loop = abap_true.
          lv_complete_uri = |{ lv_complete_uri }?|.
          lv_initial_loop = abap_false.
        ENDIF.

        lv_complete_uri = |{ lv_complete_uri }{ <fs_param>-param_name }={ <fs_param>-param_value }&|.
      ENDLOOP.

      ms_api-alt_api->set_uri( lv_complete_uri ).
      " for the GET call all the headers where already generated (Fetch for the token)
      ms_api-alt_api->set_headers_of_request( ).

      ms_api-alt_api->call_api( EXPORTING iv_timeout          = 60  "changed from 10 seconds to 60 seconds During Wave1b golive
                                IMPORTING ev_code             = lv_code
                                          ev_reason           = lv_reason
                                          et_response_headers = lt_response_headers
                                          ev_response_body    = lv_response_body
                                          et_cookies          = lt_cookies ).
*      IF lv_code CP '2++'.
*        READ TABLE mt_api_auth ASSIGNING FIELD-SYMBOL(<fs_auth>) WITH KEY location  = ms_api-loc_id
*                                                                          process   = ms_api-process
*                                                                          auth_mode = ms_api-auth_mode BINARY SEARCH.
*        IF sy-subrc IS NOT INITIAL.
*          RAISE EXCEPTION NEW /rb4r/lo_cx_rest_frmwrk( ).
*        ENDIF.
*        SORT lt_response_headers BY name.
*        READ TABLE lt_response_headers ASSIGNING FIELD-SYMBOL(<fs_response_header>) WITH KEY name = <fs_auth>-oauth_token_para BINARY SEARCH.
*        IF sy-subrc IS NOT INITIAL.
*          RAISE EXCEPTION NEW /rb4r/lo_cx_rest_frmwrk( ).
*        ENDIF.

      " update the token value for the main API
*        ms_api-main_api->update_specific_header_value( iv_name  = <fs_response_header>-name
*                                                       iv_value = <fs_response_header>-value ).
      ms_api-main_api->add_cookies( it_cookies = lt_cookies ).

      " now the fetched token has been added into the headers :)
      ms_api-main_api->set_headers_of_request( ).
*      ELSE.
*        ls_textid = VALUE #( msgid = mc_messageclass
*                             msgno = '026'
*                             attr1 = lv_code
*                             attr2 = lv_reason ). "  API Call returned error &1: &2
*        DATA(lr_exception) = NEW /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
*        RAISE EXCEPTION lr_exception.
    ENDIF.


    " then build the full URI of the main API Call
    lv_complete_uri = ms_api-main_api->mv_uri.

    LOOP AT mt_api_parameters ASSIGNING <fs_param> WHERE param_mode = mc_param_path ."AND odata_main_flag = abap_true.
      lv_complete_uri = |{ lv_complete_uri }/{ <fs_param>-param_name }('{ <fs_param>-param_value }')|.
    ENDLOOP.

    LOOP AT mt_api_parameters ASSIGNING <fs_param> WHERE param_mode = mc_param_query.
      IF lv_initial_loop = abap_true.
        lv_complete_uri = |{ lv_complete_uri }?|.
        lv_initial_loop = abap_false.
      ENDIF.
      IF  <fs_param>-param_value IS NOT INITIAL.
        lv_complete_uri = |{ lv_complete_uri }{ <fs_param>-param_name }={ <fs_param>-param_value }&|.
      ENDIF.
    ENDLOOP.

    IF lv_complete_uri is NOT INITIAL.
    DATA(lv_length_uri) = strlen( lv_complete_uri ).
     data(lv_length) = lv_length_uri - 1.
    IF lv_complete_uri+lv_length(1) = '&'.
      lv_complete_uri =  lv_complete_uri(lv_length).
    ENDIF.
    ms_api-main_api->set_uri( lv_complete_uri ).
    ms_api-main_api->set_headers_of_request( ).

    IF lines( mt_api_body ) > 0.
      " now add the body to the request
      lv_body = '{'.
      LOOP AT mt_api_body ASSIGNING FIELD-SYMBOL(<fs_body>).
        lv_body = |{ lv_body }"{ <fs_body>-body_name }": "{ <fs_body>-body_value }",|.
      ENDLOOP.
      DATA(lv_len_new) = strlen( lv_body ) - 1.
      lv_body = lv_body(lv_len_new).
      lv_body = |{ lv_body }\}|.

      ms_api-main_api->set_body( iv_body = lv_body ).
    ENDIF.

    ms_api-main_api->call_api( EXPORTING iv_timeout          = 10
                               IMPORTING ev_code             = ev_code
                                         ev_reason           = ev_reason
                                         et_response_headers = et_response_headers
                                         ev_response_body    = ev_response_body
                                         eo_http_client  = DATA(lo_http_client)
                                         ev_spool    =  ev_spool ).

    DATA(ls_return) = /rb4c/cl_ca_aom_enabler=>log(
                          iv_ns             = ms_api-namespace
                          iv_ifname         = ms_api-ifname
                          iv_ifver          = ms_api-ifver
                          iv_commit         = sy-batch
                          io_http_client    =  lo_http_client
                        ).
    IF ls_return IS NOT INITIAL.
      MESSAGE ID      ls_return-id
              TYPE    'S'
              NUMBER  ls_return-number
              WITH    ls_return-message_v1
                      ls_return-message_v2
                      ls_return-message_v3
                      ls_return-message_v4.
    ENDIF.



    IF ev_code CP '2++'.
      "in this case we dont need to do anything more here :)
    ELSE.
      ls_textid = VALUE #( msgid = mc_messageclass
                             msgno = '026'
                             attr1 = ev_code
                             attr2 = ev_reason
                             attr3 = ev_response_body ). "  API Call returned error &1: &2
      DATA(lr_exception) = NEW /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
      RAISE EXCEPTION lr_exception.
    ENDIF.
ENDIF.

  ENDMETHOD.


  METHOD constructor.
    DATA ls_textid TYPE scx_t100key.

    SELECT werks, srvtype, method, rfcdest, uri,namespace, ifname, ifver
      FROM /rb4r/lo_apis
      INTO CORRESPONDING FIELDS OF TABLE @mt_relevant_apis
      WHERE werks = @iv_plant  AND srvtype = @iv_service.
    IF sy-subrc IS NOT INITIAL OR lines( mt_relevant_apis ) IS INITIAL.
      " no data maintained --> no call possible
      ls_textid = VALUE #( msgid = mc_messageclass
                           msgno = '016'
                           attr1 = iv_plant
                           attr2 = iv_service ). "  no API(s) could be found for werks &1 and process &2
      DATA(lr_exception) = NEW /rb4r/lo_cx_rest_frmwrk( textid = ls_textid ).
      RAISE EXCEPTION lr_exception.
    ENDIF.

    SELECT werks, srvtype, method, header_name, header_value
      FROM /rb4r/lo_api_hf
      INTO CORRESPONDING FIELDS OF TABLE @mt_api_headers
      FOR ALL ENTRIES IN @mt_relevant_apis
      WHERE werks = @mt_relevant_apis-werks  AND srvtype = @mt_relevant_apis-srvtype AND method = @mt_relevant_apis-method.
    IF sy-subrc IS NOT INITIAL.
      " call without headers is unlikely but possible
    ENDIF.

    SELECT werks, srvtype, method, param_name, param_value, param_mode
      FROM /rb4r/lo_api_pa
      INTO CORRESPONDING FIELDS OF TABLE @mt_api_parameters
      FOR ALL ENTRIES IN @mt_relevant_apis
      WHERE werks = @mt_relevant_apis-werks  AND  srvtype = @mt_relevant_apis-srvtype AND method = @mt_relevant_apis-method.
    IF sy-subrc IS NOT INITIAL.
      " call without parameters is possible
    ENDIF.

    SELECT werks,srvtype, method, body_name, body_value
      FROM /rb4r/lo_api_bo
      INTO CORRESPONDING FIELDS OF TABLE @mt_api_body
      FOR ALL ENTRIES IN @mt_relevant_apis
      WHERE werks = @mt_relevant_apis-werks AND srvtype = @mt_relevant_apis-srvtype AND method = @mt_relevant_apis-method.
    IF sy-subrc IS NOT INITIAL.
      " call without a body is possible
    ENDIF.
    LOOP AT mt_relevant_apis ASSIGNING FIELD-SYMBOL(<fs_api>).
      ms_api = create_rfcdest_api( is_api = <fs_api> ).
      ms_api-loc_id = iv_plant.
      ms_api-process = iv_service.
      ms_api-namespace = <fs_api>-namespace.
      ms_api-ifname = <fs_api>-ifname.
      ms_api-ifver = <fs_api>-ifver.
      ms_api-process = iv_service.
      "     ms_api-auth_mode = <fs_api>-auth_mode.
    ENDLOOP.
  ENDMETHOD.


  METHOD create_rfcdest_api.
    DATA lv_content_type TYPE string.
    DATA lt_headers      TYPE tihttpnvp.
    generic_api_creation_steps( EXPORTING is_api          = is_api
                                IMPORTING ev_alt_api      = r_result-alt_api
                                          ev_content_type = lv_content_type
                                          et_headers      = lt_headers ).

    r_result-main_api = NEW /rb4r/lo_cl_rest_api_request( iv_method       = CONV #( is_api-method )
                                                           iv_rfc_dest     = is_api-rfcdest
                                                           iv_content_type = lv_content_type
                                                           iv_uri          = CONV #( is_api-uri )
                                                           it_headers      = lt_headers ).
  ENDMETHOD.


